{
  "name": "architectos-learning-product",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "v2:catalog": "node scripts/build-v2-catalog.mjs",
    "predev": "node scripts/build-v2-catalog.mjs && node scripts/merge-topics.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-v2-catalog.mjs && node scripts/merge-topics.mjs",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/build-v2-catalog.mjs && node scripts/merge-topics.mjs",
    "preview": "vite preview",
    "prevalidate:content": "node scripts/build-v2-catalog.mjs && node scripts/merge-topics.mjs",
    "validate:content": "node scripts/validate-content.mjs && node scripts/build-v2-catalog.mjs",
    "freshness": "node scripts/v2-maintenance.mjs --mode=all",
    "check": "npm run validate:content && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
